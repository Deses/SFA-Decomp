+#![cfg(feature = "ppc")]
+use objdiff_core::{
+    arch::ppc::ArchPpc,
+    diff::{self, DiffObjConfig, MappingConfig},
+    obj::{
+        Object, Relocation, RelocationFlags, Section, SectionData, SectionKind, Symbol, SymbolKind,
+    },
+};
+fn fixture(named: bool) -> Object {
+    let mut obj = Object {
+        arch: Box::new(ArchPpc { extensions: powerpc::Extensions::gekko_broadway(), extab: None }),
+        ..Default::default()
+    };
+    obj.symbols.push(Symbol { name: "constructor".into(), ..Default::default() });
+    obj.sections.push(Section {
+        name: ".ctors".into(),
+        id: ".ctors".into(),
+        kind: SectionKind::Data,
+        size: 4,
+        data: SectionData(vec![0; 4]),
+        relocations: vec![Relocation {
+            flags: RelocationFlags::Elf(1),
+            address: 0,
+            target_symbol: 0,
+            addend: 0,
+        }],
+        ..Default::default()
+    });
+    if named {
+        obj.symbols.push(Symbol {
+            name: "constructor_reference".into(),
+            kind: SymbolKind::Object,
+            section: Some(0),
+            size: 4,
+            ..Default::default()
+        });
+    }
+    obj
+}
+fn score(left: &Object, right: &Object) -> f32 {
+    let d = diff::diff_objs(
+        Some(left),
+        Some(right),
+        None,
+        &DiffObjConfig::default(),
+        &MappingConfig::default(),
+    )
+    .unwrap();
+    d.left.unwrap().sections[0].match_percent.unwrap()
+}
+#[test]
+fn named_and_anonymous_constructor_match() {
+    assert_eq!(score(&fixture(true), &fixture(false)), 100.0);
+}
+#[test]
+fn anonymous_constructor_bytes_are_compared() {
+    for named in [true, false] {
+        let left = fixture(named);
+        let mut right = fixture(false);
+        right.sections[0].data.0[0] = 0x80;
+        assert!(score(&left, &right) < 100.0);
+    }
+}
+#[test]
+fn anonymous_constructor_addend_is_compared() {
+    for named in [true, false] {
+        let left = fixture(named);
+        let mut right = fixture(false);
+        right.sections[0].relocations[0].addend = 4;
+        assert!(score(&left, &right) < 100.0);
+    }
+}
+#[test]
+fn anonymous_constructor_target_is_compared() {
+    for named in [true, false] {
+        let left = fixture(named);
+        let mut right = fixture(false);
+        right.symbols[0].name = "other_constructor".into();
+        assert!(score(&left, &right) < 100.0);
+    }
+}
+#[test]
+fn extra_source_relocation_is_not_ignored() {
+    for named in [true, false] {
+        let mut left = fixture(named);
+        left.sections[0].relocations.clear();
+        assert!(score(&left, &fixture(false)) < 100.0);
+    }
+}
+#[test]
+fn missing_source_relocation_is_not_ignored() {
+    for named in [true, false] {
+        let mut right = fixture(false);
+        right.sections[0].relocations.clear();
+        assert!(score(&fixture(named), &right) < 100.0);
+    }
+}
+
+#[allow(dead_code)]
+mod common;
+fn metadata_pair() -> (Object, Object) {
+    let config = DiffObjConfig::default();
+    let left = objdiff_core::obj::read::parse(
+        include_object!("data/ppc/metadata/target.o"),
+        &config,
+        diff::DiffSide::Target,
+    )
+    .unwrap();
+    let right = objdiff_core::obj::read::parse(
+        include_object!("data/ppc/metadata/source.o"),
+        &config,
+        diff::DiffSide::Base,
+    )
+    .unwrap();
+    (left, right)
+}
+fn section_score(left: &Object, right: &Object, section: &str) -> f32 {
+    let result = diff::diff_objs(
+        Some(left),
+        Some(right),
+        None,
+        &DiffObjConfig::default(),
+        &MappingConfig::default(),
+    )
+    .unwrap();
+    let idx = left.sections.iter().position(|s| s.name == section).unwrap();
+    result.left.unwrap().sections[idx].match_percent.unwrap()
+}
+#[test]
+fn exception_records_match_by_function_identity() {
+    let (left, right) = metadata_pair();
+    for section in ["extab", "extabindex"] {
+        assert_eq!(section_score(&left, &right, section), 100.0, "{section}");
+    }
+}
+#[test]
+fn exception_payload_is_compared() {
+    let (left, mut right) = metadata_pair();
+    let section = right.sections.iter_mut().find(|s| s.name == "extab").unwrap();
+    section.data.0[16] ^= 0x10;
+    assert!(section_score(&left, &right, "extab") < 100.0);
+}
+#[test]
+fn exception_index_length_is_compared() {
+    let (left, mut right) = metadata_pair();
+    let section = right.sections.iter_mut().find(|s| s.name == "extabindex").unwrap();
+    section.data.0[31] = 8;
+    assert!(section_score(&left, &right, "extabindex") < 100.0);
+}
+#[test]
+fn exception_index_function_is_compared() {
+    let (left, mut right) = metadata_pair();
+    let other = right.symbols.iter().position(|s| s.name == "unusedA").unwrap();
+    let section = right.sections.iter_mut().find(|s| s.name == "extabindex").unwrap();
+    section.relocations.iter_mut().find(|r| r.address == 24).unwrap().target_symbol = other;
+    assert!(section_score(&left, &right, "extabindex") < 100.0);
+}
+#[test]
+fn exception_index_table_is_compared() {
+    let (left, mut right) = metadata_pair();
+    let other = right.symbols.iter().position(|s| s.name == "source_etb_0").unwrap();
+    let section = right.sections.iter_mut().find(|s| s.name == "extabindex").unwrap();
+    section.relocations.iter_mut().find(|r| r.address == 32).unwrap().target_symbol = other;
+    assert!(section_score(&left, &right, "extabindex") < 100.0);
+}
+#[test]
+fn exception_index_addend_is_compared() {
+    let (left, mut right) = metadata_pair();
+    let section = right.sections.iter_mut().find(|s| s.name == "extabindex").unwrap();
+    section.relocations.iter_mut().find(|r| r.address == 32).unwrap().addend += 4;
+    assert!(section_score(&left, &right, "extabindex") < 100.0);
+}
+
+#[test]
+fn shared_exception_table_keeps_ambiguous_name() {
+    let config = DiffObjConfig::default();
+    let obj = objdiff_core::obj::read::parse(
+        include_object!("data/ppc/metadata/shared.o"),
+        &config,
+        diff::DiffSide::Base,
+    )
+    .unwrap();
+    let shared = obj.symbols.iter().find(|s| s.name == "source_etb_0").unwrap();
+    assert_eq!(shared.normalized_name, None);
+    let main = obj.symbols.iter().find(|s| s.name == "source_etb_2").unwrap();
+    assert_eq!(main.normalized_name.as_deref(), Some("[extab:fixtureMain]"));
+}
+#[test]
+fn incorrect_exception_owner_is_not_paired() {
+    let config = DiffObjConfig::default();
+    let (left, _) = metadata_pair();
+    let right = objdiff_core::obj::read::parse(
+        include_object!("data/ppc/metadata/wrong_owner.o"),
+        &config,
+        diff::DiffSide::Base,
+    )
+    .unwrap();
+    assert!(section_score(&left, &right, "extabindex") < 100.0);
+    assert!(
+        !right
+            .symbols
+            .iter()
+            .any(|s| s.normalized_name.as_deref() == Some("[extabindex:fixtureMain]"))
+    );
+}
